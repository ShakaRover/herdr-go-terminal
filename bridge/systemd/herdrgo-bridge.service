[Unit]
Description=herdrgo-bridge (Rust REST bridge for herdr)
After=default.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/bin/herdrgo-bridge
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
Environment=HERDR_SOCKET_PATH=%h/.config/herdr/herdr.sock
Environment=HERDRGO_BRIDGE_STATE_DIR=%h/.local/state/herdrgo-bridge
EnvironmentFile=-%h/.config/herdrgo-bridge/env

[Install]
WantedBy=default.target
